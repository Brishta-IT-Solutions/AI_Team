# Copy to .env and fill in what you have. Anything left blank just keeps that team member offline.

# ── Business analyst: Gemini ───────────────────────────────────────────────
# https://aistudio.google.com/apikey  (Antigravity works without this: use "Copy brief for Antigravity")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# ── Developer + UX: Claude Code ────────────────────────────────────────────
# Either an API key from console.anthropic.com, or run `claude setup-token` to use a Pro/Max plan.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=

# ── QA: Codex ──────────────────────────────────────────────────────────────
# ChatGPT plan: leave this blank and sign in once with
#   docker compose run --rm worker codex login --device-auth
# (the sign-in is kept in the codex-home volume). Or paste an OpenAI API key instead.
OPENAI_API_KEY=
CODEX_MODEL=

# ── Junior: Ollama on this computer ────────────────────────────────────────
# Recommended: `ollama pull qwen3-coder`, then OLLAMA_MODEL=qwen3-coder (needs ~24 GB RAM/VRAM;
# qwen2.5-coder:7b on smaller machines). Blank = the first coding model you have pulled.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# ── Projects and repositories ─────────────────────────────────────────────
# The projects the team works on, by key. Add a project here after creating it in the app.
AITC_PROJECTS=PORTAL
# A GitHub token so the team can clone private repos and push feature/* branches (never main).
# Fine-grained token with Contents: read and write on those repos. Only git sees it, never the AI tools.
GITHUB_TOKEN=
# The demo project's code: blank = a small built-in demo repository, or a git URL.
AITC_REPO_URL=
# Also push the demo project's feature branches to AITC_REPO_URL.
AITC_PUSH_BRANCHES=false

# ── Sharing on your local network ─────────────────────────────────────────
# Anyone on the network who opens http://<this computer's IP>:3000 must enter this code first.
# Set it before sharing. It keeps strangers out; it is not per-person sign-in ("Acting as" still
# picks the identity until OIDC arrives). Leave blank only if nobody else can reach this computer.
AITC_ACCESS_CODE=

# ── Development-only settings for running the API and web natively ─────────
AITC_ENV=development
AITC_DATABASE_URL=postgresql+psycopg://aitc:aitc@localhost:5432/aitc
AITC_DEV_AUTH_ENABLED=true
