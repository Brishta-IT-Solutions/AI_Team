# Copy to .env and fill in what you have. Anything left blank just keeps that team member offline.

# ── Business analyst: Gemini ───────────────────────────────────────────────
# https://aistudio.google.com/apikey  (Antigravity works without this: use "Copy brief for Antigravity")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# ── Developer + UX: Claude Code ────────────────────────────────────────────
# Either an API key from console.anthropic.com, or run `claude setup-token` to use a Pro/Max plan.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL=

# ── QA: Codex ──────────────────────────────────────────────────────────────
# ChatGPT plan: leave this blank and sign in once with
#   docker compose run --rm worker codex login --device-auth
# (the sign-in is kept in the codex-home volume). Or paste an OpenAI API key instead.
OPENAI_API_KEY=
CODEX_MODEL=

# ── Junior: Ollama on this computer ────────────────────────────────────────
# Leave OLLAMA_MODEL blank to use the first coding model you have pulled.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# ── Which codebase the team works on ───────────────────────────────────────
# Blank = a small built-in demo project. Or a git URL (with a token for private repos).
AITC_REPO_URL=
# Push feature branches back to AITC_REPO_URL (never the main branch).
AITC_PUSH_BRANCHES=false

# ── Development-only settings for running the API and web natively ─────────
AITC_ENV=development
AITC_DATABASE_URL=postgresql+psycopg://aitc:aitc@localhost:5432/aitc
AITC_DEV_AUTH_ENABLED=true
NEXT_PUBLIC_API_URL=http://localhost:8000
